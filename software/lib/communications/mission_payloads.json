    "precision_conflicts": [
      "CTR21 versus Container telemetry voltage precision (0.01V versus0.1V).",
      "PQ27 expresses A while telemetry table uses mA; wire chooses signed mA.",
      "PQ31 versus telemetry table solar precision (0.1V versus0.01V)."
    ],
    "state_mapping": "Do not cast internal ContainerPhase directly. Release requested is not PQ_RELEASE until qualified clearance; landed has no published CSV state and telemetry stops. Final dispatcher/export mapping requires explicit review."
  },
  "selection_status": "User confirmed explicit validity flags with precise scaled-integer units, bounded versioned extensions while fields remain undefined, and mission-only commands on 2026-10-10. Other detailed wire choices remain experimental engineering decisions.",
  "limits": [
    "No hardware activation or command execution.",
    "No sensor-unit conversion from floating samples implemented; callers must explicitly range-check and quantize.",
    "Validity is not measured accuracy.",
    "GNSS text limited to32bytes; excess is rejected, never truncated.",
    "No extension data interpretation until a profile/version is defined."
  ]
