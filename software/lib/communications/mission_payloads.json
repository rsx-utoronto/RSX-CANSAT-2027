  "validity_contract": {
    "zero_means": "Value zero is meaningful only when its validity bit is set. Cleared bits require canonical zero numeric storage and empty padded text.",
    "mask_rules": "Unknown validity/mechanism bits rejected; set mechanism_state bits must be known. Coordinates require latitude and longitude validity together.",
    "physical_sanity": "Valid pressure must be positive; valid temperature>=-273.150 degC; latitude[-90,+90], longitude[-180,+180] degrees. Other sensor ranges are representation bounds, not approved flight thresholds.",
    "freshness": "The acquisition/application layer decides validity using sensor status, age and calibration. This codec has no sensor clock or stale-data detector.",
    "text": "Lengths bounded; ASCII excluding whitespace/control/comma; zero padding mandatory. Echo begins uppercase and uses uppercase letters, digits, underscore, sign, dot or colon."
  },
