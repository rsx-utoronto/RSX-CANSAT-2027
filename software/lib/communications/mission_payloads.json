      "data_encoding": "opaque bounded bytes; no profiles selected",
      "empty_rule": "profile=0, profile_version=0, data_length=0",
      "nonempty_rule": "profile and profile_version nonzero; data_length1..43; combined lengths<=43",
      "unknown_profile_policy": "Retain bounded bytes with their profile/version. No interpretation or CSV flattening until profile is registered.",
      "reserved_slots": [
        "STABILIZATION_PROFILE",
        "SCIENCE_PROFILE"
      ]
    }
