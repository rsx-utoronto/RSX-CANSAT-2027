              "stop": 2
            }
          }
        ],
        "bytes": 4
      },
      {
        "id": 8,
        "name": "VIEW",
        "type": "RotateView",
        "targets": [
          "P"
        ],
        "body": [
          {
            "name": "delta_mdeg",
            "encoding": "i32le",
            "offset": 3,
            "bytes": 4,
            "minimum": -360000,
            "maximum": 360000,
            "exclude": [
              0
            ],
            "unit": "0.001 degree; right-hand about nadir +Z"
          }
        ],
        "bytes": 7
      }
    ],
    "wire_catalog_policy": "Mission operations only; no generic GPIO, servo-angle, reset, memory-write or debug command. Recording/view commands are team-defined mission extensions.",
    "execution_boundary": "Decoder validates syntax, enums, length and target, not authorization or state. An application dispatcher must separately enforce SIM ENABLE then ACTIVATE, pressure injection only when active, launch/calibration timing, mechanism policy and feedback. No actuation occurs in these codecs.",
    "rotation_policy": "Single-turn nonzero relative view command. +/-360degrees is a team-defined protocol bound, not a tested mechanical limit. Duplicate/reboot handling must preserve command identity; never replay with a new ID automatically.",
    "echo": "commandEcho produces a bounded comma-free token; VIEW numeric argument is milli-degrees, ST milliseconds, SIMP pascals. Telemetry echo is application supplied after processing, not transport MAC receipt."
  },
  "counter_and_time_ownership": {
    "packet_count": "Application-owned cumulative telemetry-transmission counter, separate from radio message_id; persistence/overflow handling not implemented by codec.",
    "command_count": "Proposed semantic: authenticated syntactically valid unique commands admitted to processing; retries excluded, policy rejection still processed. Confirm scoring interpretation before flight. No increment logic implemented here.",
    "mission_time_ms": "Application-owned elapsed mission clock, recoverable across resets; NOT UTC Unix milliseconds.",
    "set_utc": "A separate UTC reference command; mapping to mission clock is a recovery/application concern."
  },
