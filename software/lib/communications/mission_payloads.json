              "solar_1": 2,
              "solar_2": 3,
              "boom": 4
            },
            "target_rule": "C permits1 only; P permits2,3,4 only"
          }
        ],
        "bytes": 4
      },
      {
        "id": 7,
        "name": "RECORD",
        "type": "Recording",
        "targets": [
