    "wire_to_display": "mm -> m; milli-C -> C; mV -> V; milli-degrees/s -> degrees/s; mm/s^2 -> m/s^2; nanodegrees -> degrees. mA/mG already canonical for the telemetry tables.",
    "open_slots": [
      "INVALID_READING_EXPORT_POLICY",
      "STABILIZATION_CSV_COLUMNS",
      "SCIENCE_CSV_COLUMNS",
      "GUIDE_PRECISION_CLARIFICATION"
